# Baked into the production Vite bundle at `npm run build` time (mode=production).
# Both values are PUBLIC server URLs (no credential belongs here; bot tokens live
# only in the server's own environment). See src/vite-env.d.ts.
#
# v1 one-tap dispatch endpoint (contracts/prompt-run-v1.md). Kept as the rollback
# path until the two-bot pilot retires it. Endpoint adopted in MAI-423.
VITE_PROMPT_RUN_ENDPOINT=https://n8n.st-metro.dev/prompt-pocket/api/prompt-run
# v2 API base (contracts/prompt-run-v2.md, contracts/shared-pocket-v1.md). Every
# v2 URL is this base plus a POCKET_ROUTES path from shared/pocket-contract.ts.
VITE_PROMPT_POCKET_API_BASE=https://n8n.st-metro.dev/prompt-pocket
