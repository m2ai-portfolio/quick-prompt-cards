# Copy to .env.local for local development. Both values are PUBLIC server URLs;
# no credential ever belongs in a VITE_ variable (Vite inlines them into the
# browser bundle). Bot tokens live only in the server's environment.

# v1 one-tap dispatch endpoint (contracts/prompt-run-v1.md). Leave unset to
# treat v1 dispatch as unsupported.
VITE_PROMPT_RUN_ENDPOINT=http://10.0.0.46:8787/api/prompt-run

# v2 API base (contracts/prompt-run-v2.md, contracts/shared-pocket-v1.md). All v2
# routes are appended from shared/pocket-contract.ts POCKET_ROUTES. Leave unset
# to stay in local-only mode.
VITE_PROMPT_POCKET_API_BASE=http://10.0.0.46:8787
